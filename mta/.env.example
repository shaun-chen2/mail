# 复制本文件为 .env 并填写（.env 已被 .gitignore 忽略，不会进仓库）

# 你的域名（在 Cloudflare 托管 DNS 最佳）
MAIL_DOMAIN=example.com

# 邮件服务器主机名前缀，最终 FQDN = mail.example.com
MAIL_HOSTNAME=mail

# Cloudflare API 令牌，需具备 Zone:DNS:Edit 权限（用于 Let's Encrypt DNS-01 校验）。
# 不要使用你之前给的“账户级全权限令牌”，请到 Cloudflare 后台单独建一个只含
# “Zone → DNS → Edit” 的令牌，范围限定到你的域名。
CF_DNS_API_TOKEN=
